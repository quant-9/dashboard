# --- Telegram ---
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
# Your own numeric Telegram chat id. The bot ONLY responds to this id.
# Message your bot once, then /status will tell you the id, or use @userinfobot.
# Comma-separate if you want more than one allowed chat.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- Sierra Chart DTC Protocol Server ---
# Enable in Sierra Chart: Global Settings > Data/Trade Service Settings, or the
# "DTC Protocol Server" settings. Set Encoding to JSON and note the port.
DTC_HOST=127.0.0.1
DTC_PORT=11099
# Some setups require a username/password for the DTC server; leave blank if not.
DTC_USERNAME=
DTC_PASSWORD=
# The EXACT symbol string as it appears in Sierra Chart for the NQ chart
# (data-feed dependent, e.g. NQZ25-CME, NQZ5, F.US.NQ, etc.). Confirm on your feed.
DTC_SYMBOL=NQZ25-CME

# --- Alert behavior ---
# Default proximity in points; you can override per-alert from the bot.
DEFAULT_THRESHOLD=20
# After an alert fires, wait this many seconds before it can fire again
# (unless price first exits the band by the hysteresis margin below).
COOLDOWN_SECONDS=900
# Extra points beyond the threshold that price must clear to re-arm an alert.
HYSTERESIS=5

# Path to the local SQLite database that stores your alerts.
DATABASE_PATH=nq_alerts.db
